{
  "dashboard": {
    "id": null,
    "title": "Redis Metrics Dashboard",
    "tags": ["redis", "database"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Redis Memory Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "redis_memory_used_bytes{instance=~\"$instance\"}",
            "legendFormat": "Used Memory - {{instance}}",
            "refId": "A"
          },
          {
            "expr": "redis_memory_max_bytes{instance=~\"$instance\"}",
            "legendFormat": "Max Memory - {{instance}}",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "format": "bytes"
          }
        ]
      },
      {
        "id": 2,
        "title": "Redis Connected Clients",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "redis_connected_clients{instance=~\"$instance\"}",
            "legendFormat": "Connected Clients - {{instance}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 3,
        "title": "Redis Commands Processed",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(redis_commands_processed_total{instance=~\"$instance\"}[5m])",
            "legendFormat": "Commands/Sec - {{instance}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "format": "ops"
          }
        ]
      },
      {
        "id": 4,
        "title": "Redis Key Count",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "redis_db_keys{instance=~\"$instance\"}",
            "legendFormat": "{{db}} - {{instance}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "format": "short"
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(redis_up, instance)",
          "refresh": 1,
          "includeAll": false,
          "multi": false
        }
      ]
    },
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}