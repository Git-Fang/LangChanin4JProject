{
  "dashboard": {
    "id": null,
    "title": "JVM Metrics Dashboard",
    "tags": ["jvm", "micrometer", "spring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "JVM Memory",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{application=\"$application\", area=\"heap\"}",
            "legendFormat": "{{id}} ({{area}})",
            "refId": "A"
          },
          {
            "expr": "jvm_memory_max_bytes{application=\"$application\", area=\"heap\"}",
            "legendFormat": "{{id}} ({{area}}) Max",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "format": "bytes"
          }
        ]
      },
      {
        "id": 2,
        "title": "JVM CPU Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(process_cpu_seconds_total{application=\"$application\"}[5m])",
            "legendFormat": "CPU Usage Rate",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "format": "percent"
          }
        ]
      },
      {
        "id": 3,
        "title": "Garbage Collection",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(jvm_gc_pause_seconds_count{application=\"$application\"}[5m])",
            "legendFormat": "{{action}} {{cause}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Thread Count",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "jvm_threads_live{application=\"$application\"}",
            "legendFormat": "Live Threads",
            "refId": "A"
          },
          {
            "expr": "jvm_threads_daemon{application=\"$application\"}",
            "legendFormat": "Daemon Threads",
            "refId": "B"
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "application",
          "type": "query",
          "query": "label_values(application)",
          "refresh": 1,
          "includeAll": false,
          "multi": false
        }
      ]
    },
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}