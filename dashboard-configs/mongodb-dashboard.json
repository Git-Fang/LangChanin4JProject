{
  "dashboard": {
    "id": null,
    "title": "MongoDB Metrics Dashboard",
    "tags": ["mongodb", "database"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "MongoDB Connections",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "mongodb_connections_current{instance=~\"$instance\"}",
            "legendFormat": "Current Connections - {{instance}}",
            "refId": "A"
          },
          {
            "expr": "mongodb_connections_available{instance=~\"$instance\"}",
            "legendFormat": "Available Connections - {{instance}}",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "format": "short"
          }
        ]
      },
      {
        "id": 2,
        "title": "MongoDB Operations",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(mongodb_opcounters_total{instance=~\"$instance\"}[5m])",
            "legendFormat": "{{type}} - {{instance}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "format": "ops"
          }
        ]
      },
      {
        "id": 3,
        "title": "MongoDB Memory Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "mongodb_memory_resident{instance=~\"$instance\"}",
            "legendFormat": "Resident Memory - {{instance}}",
            "refId": "A"
          },
          {
            "expr": "mongodb_memory_virtual{instance=~\"$instance\"}",
            "legendFormat": "Virtual Memory - {{instance}}",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "format": "bytes"
          }
        ]
      },
      {
        "id": 4,
        "title": "MongoDB Network",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "rate(mongodb_network_bytes_total{instance=~\"$instance\", type=\"in\"}[5m])",
            "legendFormat": "Network In - {{instance}}",
            "refId": "A"
          },
          {
            "expr": "rate(mongodb_network_bytes_total{instance=~\"$instance\", type=\"out\"}[5m])",
            "legendFormat": "Network Out - {{instance}}",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "format": "Bps"
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(mongodb_up, instance)",
          "refresh": 1,
          "includeAll": false,
          "multi": false
        }
      ]
    },
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}