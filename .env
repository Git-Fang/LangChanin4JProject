# 仅保留启动必需的环境变量，其余配置（含密钥）统一由 Nacos 配置中心下发
# 配置项位置：Nacos -> RAGTranslationApplication-docker.yml -> DEFAULT_GROUP
SPRING_PROFILES_ACTIVE=docker

# Nacos 已开启鉴权，启动时还需提供以下两项（属部署环境机密，不写入版本库）：
#   NACOS_USERNAME=nacos
#   NACOS_PASSWORD=<管理员密码>
# 建议通过 docker run --env-file 注入，如：--env-file /path/to/app.env

# 容器时区
TZ=Asia/Shanghai